#. module: l10n_uy_edi_pos_ux
#: model:ir.model.fields,help:l10n_uy_edi_pos_ux.field_pos_config__l10n_uy_allow_close_with_cfe_error
#: model:ir.model.fields,help:l10n_uy_edi_pos_ux.field_res_config_settings__pos_l10n_uy_allow_close_with_cfe_error
