#. module: l10n_uy_edi_pos_ux
#. odoo-python
#: code:addons/l10n_uy_edi_pos_ux/models/account_move.py:0
msgid ""
"The CFE was issued, but Uruware did not return its PDF. Try again in a few "
"minutes, or print it from the invoice in the backend."
msgstr ""
"El CFE se emitió, pero Uruware no devolvió su PDF. Vuelva a intentarlo en "
"unos minutos o imprímalo desde la factura en el backend."

#. module: l10n_uy_edi_pos_ux
#. odoo-javascript
#: code:addons/l10n_uy_edi_pos_ux/static/src/js/account_move_service.js:0
