<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_pos_order_search" model="ir.ui.view">
        <field name="name">pos.order.search.l10n_uy_edi_pos_ux</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_order_filter"/>
        <field name="arch" type="xml">
            <search position="inside">
                <filter string="CFE in error" name="l10n_uy_cfe_error" domain="[('l10n_uy_edi_cfe_state', '=', 'error')]"/>
            </search>
        </field>
    </record>

    <record id="view_pos_order_tree" model="ir.ui.view">
        <field name="name">pos.order.list.l10n_uy_edi_pos_ux</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_order_tree"/>
        <field name="arch" type="xml">
            <field name="state" position="before">
                <field name="l10n_uy_edi_cfe_state" optional="show" decoration-danger="l10n_uy_edi_cfe_state == 'error'"/>
            </field>
        </field>
    </record>

</odoo>
