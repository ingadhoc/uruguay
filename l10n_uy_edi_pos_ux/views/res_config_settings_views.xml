<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.l10n_uy_edi_pos_ux</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <setting id="pos_default_journals" position="after">
                <setting id="l10n_uy_cfe_error_flow" string="Flow when the CFE fails" help="PoC: what happens to the invoice when DGI does not validate its CFE. Hover the field to read what each option does." invisible="country_code != 'UY'">
                    <field name="pos_l10n_uy_cfe_error_flow"/>
                    <div class="mt-2" invisible="pos_l10n_uy_cfe_error_flow not in ('draft', 'posted_then_draft', 'contingency')">
                        <field name="pos_l10n_uy_allow_close_with_cfe_error"/> <label for="pos_l10n_uy_allow_close_with_cfe_error"/>
                    </div>
                    <div><field name="pos_l10n_uy_simulate_cfe_error"/> <label for="pos_l10n_uy_simulate_cfe_error"/></div>
                </setting>
                <setting id="l10n_uy_check_final_consumer_limit" invisible="country_code != 'UY'" help="Before paying, ask for an identified customer when the sale exceeds the amount DGI allows for an unidentified one.">
                    <field name="pos_l10n_uy_check_final_consumer_limit"/>
                </setting>
            </setting>
        </field>
    </record>

</odoo>
