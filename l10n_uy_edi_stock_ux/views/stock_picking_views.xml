<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_edi_ux_form" model="ir.ui.view">
        <field name="model">stock.picking</field>
        <field name="name">stock.picking.edi_ux.form</field>
        <field name="inherit_id" ref="l10n_uy_edi_stock.view_picking_edi_form" />
        <field name="arch" type="xml">

            <xpath expr="//page[@name='uy_edi']/group" position="after">
                <group colspan="2">
                    <button name="uy_stock_action_get_pdf" type="object" string="Get PDF" class="oe_inline oe_link" invisible="state != 'done' or l10n_uy_edi_cfe_state not in ('accepted', 'received')"/>
                    <button name="uy_stock_action_preview_xml" type="object" string="Preview" class="oe_inline oe_link" invisible="state != 'done' or l10n_uy_edi_cfe_state"/>
                    <button name="uy_stock_action_validate_cfe" type="object" string="Validate" class="oe_inline oe_link" invisible="state != 'done' or l10n_uy_edi_cfe_state"/>
                    <field name="l10n_uy_cfe_xml" nolabel="1" widget="ace" colspan="2" invisible="not l10n_uy_cfe_xml or l10n_uy_edi_cfe_state"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
