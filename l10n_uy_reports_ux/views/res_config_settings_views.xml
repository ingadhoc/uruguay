<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record model="ir.ui.view" id="res_config_settings_view_form_inherit_l10n_uy_reports_ux">
        <field name="name">res.config.settings.view.form.inherit.l10n_uy_reports_ux</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">

            <xpath expr="//app[@name='account']/block" position="after">
                <block title="Uruguayan Declarations" id="uy_declarations" invisible="country_code != 'UY'">
                    <setting id="uy_dgi_address" string="DGI Address Codes" company_dependent="1"
                             help="Department and locality reported on every record of the form 3150 file.">
                        <div class="content-group">
                            <div class="row mt16">
                                <label for="l10n_uy_dgi_department_code" class="col-lg-3 o_light_label"/>
                                <field name="l10n_uy_dgi_department_code"/>
                            </div>
                            <div class="row mt16">
                                <label for="l10n_uy_dgi_locality_code" class="col-lg-3 o_light_label"/>
                                <field name="l10n_uy_dgi_locality_code" placeholder="AA"/>
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>

        </field>
    </record>

</odoo>
