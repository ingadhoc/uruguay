    <record model="ir.ui.view" id="view_base_partner_update_from_padron_uy_form">
        <field name="name">res.partner.update.from.padron.wizard.form</field>
        <field name="model">res.partner.update.from.padron.wizard</field>
        <field name="inherit_id" ref="partner_autocomplete_wizard.view_base_partner_update_from_padron_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="attributes">
                <attribute name="string">Update From DGI</attribute>
            </xpath>

            <xpath expr="//p[@class='oe_grey']" position="replace">
                <p class="oe_grey" invisible="state != 'option'">
                    Only Partners with RUT/RUC are going to be updated.<br/>
                    Select the list of fields you want to update.
                </p>
            </xpath>

            <xpath expr="//button[@name='automatic_process_cb']" position="attributes">
                <attribute name="confirm">Are you sure to execute the automatic update of your partners?</attribute>
            </xpath>
        </field>
    </record>

    <record id="action_partner_update" model="ir.actions.act_window">
        <field name="name">Automatic Update from DGI</field>
        <field name="res_model">res.partner.update.from.padron.wizard</field>
        <field name="binding_model_id" ref="model_res_partner"/>
        <field name="target">new</field>
        <field name="view_mode">form</field>
    </record>


</odoo>
