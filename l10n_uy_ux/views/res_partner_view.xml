<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="action_partner_is_electronic_issuer" model="ir.actions.server">
        <field name="name">Check Electronic Issuer in DGI</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="binding_model_id" ref="base.model_res_partner"/>
        <field name="binding_view_types">form</field>
        <field name="state">code</field>
        <field name="code">action = record.action_l10n_uy_is_electronic_issuer()</field>
    </record>

    <record id="action_partner_update_from_dgi" model="ir.actions.server">
        <field name="name">Update from DGI</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="binding_model_id" ref="base.model_res_partner"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">action = records.l10n_uy_ux_update_from_dgi()</field>
    </record>

    <record id="action_partner_update_all_from_dgi" model="ir.actions.server">
        <field name="name">Update Partners From DGI</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="state">code</field>
        <field name="code">action = model.l10n_uy_ux_update_all_from_dgi()</field>
    </record>

    <menuitem id="menu_base_partner_update_from_padron_uy"
        action="action_partner_update_all_from_dgi"
        groups="base.group_system"
        parent="contacts.res_partner_menu_config"/>

</odoo>
