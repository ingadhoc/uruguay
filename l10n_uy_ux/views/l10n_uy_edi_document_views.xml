<?xml version='1.0' encoding='utf-8'?>
<odoo>

    <record id="l10n_uy_ux_document_view_form" model="ir.ui.view">
        <field name="name">l10n_uy_edi.document.view.form</field>
        <field name="model">l10n_uy_edi.document</field>
        <field name="inherit_id" ref="l10n_uy_edi.l10n_uy_edi_document_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='move_id']" position="before">
                <field name="res_model" invisible ="1"/>
                <span invisible="res_model != 'account.move'">Move </span>
                <field name="reference" widget="reference" nolabel="1"/>
            </xpath>
            <xpath expr="//field[@name='move_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>

</odoo>
